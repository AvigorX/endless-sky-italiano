 using namespace std;
 
 namespace {
+	// Decode one UTF-8 sequence and advance the pointer. Invalid or truncated
+	// sequences degrade to '?' instead of producing a random glyph cell.
+	char32_t NextCodePoint(const char *&p) noexcept
+	{
+		const unsigned char b = static_cast<unsigned char>(*p);
+		if(b < 0x80)
+		{
+			++p;
+			return b;
+		}
+		if((b >> 5) == 0x6 && p[1])
+		{
+			const char32_t c = ((b & 0x1F) << 6) | (p[1] & 0x3F);
+			p += 2;
+			return c;
+		}
+		if((b >> 4) == 0xE && p[1] && p[2])
+		{
+			const char32_t c = ((b & 0x0F) << 12) | ((p[1] & 0x3F) << 6) | (p[2] & 0x3F);
+			p += 3;
+			return c;
+		}
+		// 4-byte sequences (emoji, rare scripts) are not in the atlas.
+		if((b >> 3) == 0x1E && p[1] && p[2] && p[3])
+		{
+			p += 4;
+			return '?';
+		}
+		++p;
+		return '?';
+	}
+}
