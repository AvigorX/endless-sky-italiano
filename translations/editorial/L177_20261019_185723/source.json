  {
   "idx": 3,
   "id": "ship:Interferos|description|1498|0",
   "path": "data/avgi/avgi ships.txt",
   "line": 1498,
   "kind": "DESCRIPTION",
   "context": "ship:Interferos",
   "english": "The Interferos-class Frigate is an autonomous support ship, designed to be easy to build and disposable enough for mass production. To free up frontline warships from having to escort merchant convoys in the Tangles, the Consonance commissioned this design with the intent of licensing its sale to independent merchant captains. It has since become popular due to its impressively large armament, though its attrition rates leave something to be desired.",
   "delimiter": "quote",
   "leading_tab": false,
   "raw": "\tdescription \"The Interferos-class Frigate is an autonomous support ship, designed to be easy to build and disposable enough for mass production. To free up frontline warships from having to escort merchant convoys in the Tangles, the Consonance commissioned this design with the intent of licensing its sale to independent merchant captains. It has since become popular due to its impressively large armament, though its attrition rates leave something to be desired.\"",
   "english_hash": "dbf2eb5ddc029c9e"
  },
