  {
   "idx": 5,
   "id": "N|korath_news|word|26|0",
   "path": "data/korath/korath news.txt",
   "line": 26,
   "kind": "NEWS",
   "context": "news",
   "english": "A Korath waves you over to a stand filled with a variety of foods. It wants you to buy something, but nothing looks particularly appetizing."
  },
  {
   "idx": 6,
   "id": "N|korath_news|word|27|0",
   "path": "data/korath/korath news.txt",
   "line": 27,
   "kind": "NEWS",
   "context": "news",
   "english": "You spend some time inspecting the wares of a street vendor selling small pieces of... some sort of technology. You have no idea what any of it is."
  },
  {
   "idx": 7,
   "id": "N|korath_news|word|28|0",
   "path": "data/korath/korath news.txt",
   "line": 28,
   "kind": "NEWS",
   "context": "news",
   "english": "A merchant cries out in its own language to passerby while gesturing to a strange outfit you've never seen before. Some stop to look, but most ignore it."
  },
  {
   "idx": 8,
   "id": "N|korath_news|word|29|0",
   "path": "data/korath/korath news.txt",
   "line": 29,
   "kind": "NEWS",
   "context": "news",
   "english": "One Korath seems to be auctioning off a strange device to a small crowd."
  },
  {
   "idx": 9,
   "id": "N|korath_news|word|30|0",
   "path": "data/korath/korath news.txt",
   "line": 30,
   "kind": "NEWS",
   "context": "news",
   "english": "You enter an unusually busy building and are greeted by a Korath who seems to work there. It's filled with monitors displaying natural flora and fauna. The Korath in here are captivated by them."
  },
  {
   "idx": 10,
   "id": "N|korath_news|word|38|0",
   "path": "data/korath/korath news.txt",
   "line": 38,
   "kind": "NEWS",
   "context": "news",
   "english": "Korath worker"
  },
  {
   "idx": 11,
   "id": "N|korath_news|word|39|0",
   "path": "data/korath/korath news.txt",
   "line": 39,
   "kind": "NEWS",
   "context": "news",
   "english": "Kor Efret worker"
  },
  {
   "idx": 12,
   "id": "N|korath_news|word|42|0",
   "path": "data/korath/korath news.txt",
   "line": 42,
   "kind": "NEWS",
   "context": "news",
   "english": "The Korath attaching fuel cables to your ship stops and holds both its hands up with its palms toward you when it notices you watching."
  },
  {
   "idx": 13,
   "id": "N|korath_news|word|43|0",
   "path": "data/korath/korath news.txt",
   "line": 43,
   "kind": "NEWS",
   "context": "news",
   "english": "Two of the workers nearby are speaking to each other while gesturing to your ship. It looks like they aren't used to visitors here."
  },
  {
   "idx": 14,
   "id": "N|korath_news|word|44|0",
   "path": "data/korath/korath news.txt",
   "line": 44,
   "kind": "NEWS",
   "context": "news",
   "english": "A worker carries a crate containing several tools past you to several other Korath. They seem to be repairing an outfit - or maybe it's an air conditioning unit. You can't really tell."
  },
  {
   "idx": 15,
   "id": "N|korath_news|word|45|0",
   "path": "data/korath/korath news.txt",
   "line": 45,
   "kind": "NEWS",
   "context": "news",
   "english": "A Korath emerges from a nearby dilapidated building and begins sealing every possible entrance - windows, doors, large cracks - shut. It moves with such efficiency that you're sure it's done this plenty of times before."
  },
  {
   "idx": 16,
   "id": "N|korath_news|word|53|0",
   "path": "data/korath/korath news.txt",
   "line": 53,
   "kind": "NEWS",
