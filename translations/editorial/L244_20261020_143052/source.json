   "kind": "DESCRIPTION",
   "context": "ship:Flea",
   "english": "This combat drone is built to amplify the strength of any combat force for as few credits as possible. It was designed in conjunction with the tactical recoil of the Skipper Railgun to allow it to kite its targets, prolonging its combat efficacy while it supports its allies with debilitating ion damage.",
   "delimiter": "backtick",
   "leading_tab": false,
   "raw": "\tdescription `This combat drone is built to amplify the strength of any combat force for as few credits as possible. It was designed in conjunction with the tactical recoil of the Skipper Railgun to allow it to kite its targets, prolonging its combat efficacy while it supports its allies with debilitating ion damage.`",
   "english_hash": "ff71dfd802433a9a"
  },
