   "idx": 1,
   "id": "ship:Emperor Beetle|description|1517|0",
   "path": "data/hai/hai ships.txt",
   "line": 1517,
   "kind": "DESCRIPTION",
   "context": "ship:Emperor Beetle",
   "english": "\tMore than just a ship, the Emperor Beetle was built to inspire fear in its enemies, making it known that they face no simple Hai, but the military leaders of the Unfettered leading at the front of those they command. Some believe it to be foolish to show their leaders' ships in such a manner, but that is not how the Unfettered think. This ship was built to withstand far more punishment than any normal Shield Beetle, while still being able to dish out damage of its own.",
   "delimiter": "quote",
   "leading_tab": true,
   "raw": "\tdescription \"\tMore than just a ship, the Emperor Beetle was built to inspire fear in its enemies, making it known that they face no simple Hai, but the military leaders of the Unfettered leading at the front of those they command. Some believe it to be foolish to show their leaders' ships in such a manner, but that is not how the Unfettered think. This ship was built to withstand far more punishment than any normal Shield Beetle, while still being able to dish out damage of its own.\"",
   "english_hash": "52f1f6fb2a6ece84"
  },
