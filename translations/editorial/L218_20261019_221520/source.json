  {
   "idx": 15,
   "id": "ship:Aaulqra|description|104|0",
   "path": "data/successors/successor ships.txt",
   "line": 104,
   "kind": "DESCRIPTION",
   "context": "ship:Aaulqra",
   "english": "The Aaulqra is the oldest warship design currently produced by the High Houses in Successor space, with a recognizable lineage continuing back several thousand years to early in the old empire. It is compact, fast, and durable for a ship of its class, but has relatively limited internal space and lacks any significant cargo or passenger facilities. The captains of these vessels are often up-and-coming Successor officers hoping to prove themselves to one of the High Houses by demonstrating their mastery of the vessel; while most, of course, do not, the ship's flexibility and ubiquitous presence make it an excellent starting point for those who do.",
   "delimiter": "backtick",
   "leading_tab": false,
   "raw": "\tdescription `The Aaulqra is the oldest warship design currently produced by the High Houses in Successor space, with a recognizable lineage continuing back several thousand years to early in the old empire. It is compact, fast, and durable for a ship of its class, but has relatively limited internal space and lacks any significant cargo or passenger facilities. The captains of these vessels are often up-and-coming Successor officers hoping to prove themselves to one of the High Houses by demonstrating their mastery of the vessel; while most, of course, do not, the ship's flexibility and ubiquitous presence make it an excellent starting point for those who do.`",
   "english_hash": "0f51f8a0d65f6a25"
  },
  {
   "idx": 16,
   "id": "ship:Aaulqra|description|108|0",
   "path": "data/successors/successor ships.txt",
   "line": 108,
   "kind": "DESCRIPTION",
   "context": "ship:Aaulqra",
   "english": "This medium warship is among the most common designs employed by the High Houses of the Successors. It is compact, fast, and durable for a ship of its class, but limited internal space and fuel capacity restrict it mostly to short-range patrol service.",
   "delimiter": "quote",
   "leading_tab": false,
   "raw": "\tdescription \"This medium warship is among the most common designs employed by the High Houses of the Successors. It is compact, fast, and durable for a ship of its class, but limited internal space and fuel capacity restrict it mostly to short-range patrol service.\"",
   "english_hash": "40076602e12c6157"
  },
