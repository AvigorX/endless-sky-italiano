  {
   "idx": 31,
   "id": "ship:Ejniisde-Khora|description|283|0",
   "path": "data/successors/successor ships.txt",
   "line": 283,
   "kind": "DESCRIPTION",
   "context": "ship:Ejniisde-Khora",
   "english": "Only very few figures within the largely destitute People's Houses have the resources to assemble such an extensively-modified vessel. The comfortable passenger quarters of the stock Ejniisde have been replaced with barracks and the star liner's lightweight hull has been laid over with heavy, multi-layered armor that shields a substantially expanded weapons suite.",
   "delimiter": "backtick",
   "leading_tab": false,
   "raw": "\tdescription `Only very few figures within the largely destitute People's Houses have the resources to assemble such an extensively-modified vessel. The comfortable passenger quarters of the stock Ejniisde have been replaced with barracks and the star liner's lightweight hull has been laid over with heavy, multi-layered armor that shields a substantially expanded weapons suite.`",
   "english_hash": "195b4b7b223871fc"
  },
  {
   "idx": 32,
   "id": "ship:Ejniisde-Khora|description|284|0",
   "path": "data/successors/successor ships.txt",
   "line": 284,
   "kind": "DESCRIPTION",
   "context": "ship:Ejniisde-Khora",
   "english": "\tThe construction of illegal warships such as these by the People's Houses has been a noted concern in many recent councils between the High Houses, prompting an increase in the size and prominence of their own military fleets.",
   "delimiter": "backtick",
   "leading_tab": true,
   "raw": "\tdescription `\tThe construction of illegal warships such as these by the People's Houses has been a noted concern in many recent councils between the High Houses, prompting an increase in the size and prominence of their own military fleets.`",
