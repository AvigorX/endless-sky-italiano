  {
   "idx": 23,
   "id": "ship:Ejniisde|description|187|0",
   "path": "data/successors/successor ships.txt",
   "line": 187,
   "kind": "DESCRIPTION",
   "context": "ship:Ejniisde",
   "english": "The Successors have a relatively small population and therefore are not in great need of large transport vessels. However, transporting passengers entirely by shuttle lacks a degree of comfort and security, so for longer journeys, the Successors use this dedicated transport ship. While unarmed by default, it is fast enough to escape most ships that might mean it harm.",
   "delimiter": "quote",
   "leading_tab": false,
   "raw": "\tdescription \"The Successors have a relatively small population and therefore are not in great need of large transport vessels. However, transporting passengers entirely by shuttle lacks a degree of comfort and security, so for longer journeys, the Successors use this dedicated transport ship. While unarmed by default, it is fast enough to escape most ships that might mean it harm.\"",
   "english_hash": "a779985afcbe48c3"
  },
